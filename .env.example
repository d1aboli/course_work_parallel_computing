# Copy to .env and adjust.
# Gutenberg archive; unpacked once into the Docker volume `corpus` by the dataset-init service.
DATASET_ZIP=./D1.7GB.zip
SERVER_PORT=8080
OLLAMA_MODEL=qwen2.5:1.5b
LLM_CONCURRENCY=2
# Build the index automatically on start with N threads (0 = only via POST /api/index).
AUTO_INDEX_THREADS=0
